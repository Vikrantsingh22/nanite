{
  "name": "nanite-email",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck:scripts && npm run typecheck --workspaces --if-present",
    "typecheck:scripts": "tsc --noEmit",
    "dev": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build --workspaces --if-present",
    "db:migrate": "npm run migrate -w packages/db",
    "db:seed": "npm run seed -w packages/db",
    "owner-tx": "tsx scripts/ens/owner-tx.ts"
  },
  "dependencies": {
    "@arkiv-network/sdk": "1.0.1",
    "viem": "2.21.54"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.9.3"
  }
}
