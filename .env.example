SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
OPERATOR_PRIVATE_KEY=
TEST_SEED_MNEMONIC=
TEST_USER_PRIVATE_KEY=

# Postgres connection. This is the local Docker value (the `db` service in docker-compose.yml).
# In production (Vercel) set it to the Neon connection string from the Vercel marketplace.
DATABASE_URL=postgres://nanite:nanite@db:5432/nanite

# Public base URL of the API (no trailing slash, no path), e.g. https://api.example.com. Written into every new agent's ENS
# record agent-endpoint[mcp] as <API_PUBLIC_URL>/mcp (the hosted MCP endpoint). Set it to the real https URL before agents are
# created in production; fix existing agents with apps/api/scripts/update-agent-endpoints.ts. Default http://localhost:4000.
API_PUBLIC_URL=http://localhost:4000

# Base URL of the API service (apps/api) as seen from the browser. Local default shown.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Shared mail domain shown in example addresses on the web app (display only; the API uses SHARED_MAIL_DOMAIN). Keep them equal.
NEXT_PUBLIC_SHARED_MAIL_DOMAIN=nanitecom.itsvikrant.tech
# The /styleguide design reference is always available in development. In production it returns 404 unless this is 1.
NEXT_PUBLIC_SHOW_STYLEGUIDE=
# Browser origin the API allows via CORS (the web app). Used by apps/api.
WEB_ORIGIN=http://localhost:3000

# Resend API key (inbound/outbound email provider). Server only. Must be "Full access": a "Sending access" key
# cannot fetch received mail (401 restricted_api_key) and inbound mail would be dropped.
RESEND_API_KEY=
# Domain of every agent mailbox (<agent>.<user>@<domain>) AND the domain verified in Resend, e.g. mail.example.com.
# Must match exactly, otherwise inbound mail is not routed and outbound From is rejected. Default nanite.test (placeholder,
# the API logs a warning at startup if real Resend is configured and this is still nanite.test).
SHARED_MAIL_DOMAIN=mail.example.com
# Region of mail domains that users add in onboarding (created in Resend through the API). Default ap-northeast-1.
# Allowed: us-east-1, eu-west-1, sa-east-1, ap-northeast-1. Dev only: FAKE_RESEND_DOMAINS=1 uses an in-memory Resend and DNS.
RESEND_DEFAULT_REGION=ap-northeast-1
# Resend webhook signing secret (whsec_<base64>), used to verify inbound webhook requests.
# POST /webhooks/resend answers 503 unless RESEND_API_KEY, RESEND_WEBHOOK_SECRET and SENDER_HASH_SECRET are all set.
RESEND_WEBHOOK_SECRET=
# Master key that protects server-held secrets (wrapped agent seed material). 32 random bytes, base64. Never commit.
NANITE_MASTER_KEY=
# Secret (>= 16 chars) for the HMAC that produces `senderHash` and the opaque `threadId` on Arkiv entities. Never commit.
# Dev only: FAKE_RESEND_CONTENT=1 makes the api serve canned email content instead of calling Resend.
SENDER_HASH_SECRET=
# Nanite-wide cap on mails sent + received per UTC day, all agents (Resend free tier is 100/day). Default 90. Over the cap outbound is refused (429 quota_exhausted); inbound is still stored.
DAILY_MAIL_QUOTA=90
# Arkiv RPC access key (rate-limit key only; it is not a signing key).
ARKIV_ACCESS_KEY=
# Arkiv operator private key (0x + 64 hex): the $creator of every email entity. Optional: without it the api uses an in-memory fake writer.
# Local dev: `docker compose run --rm tools npx tsx apps/api/scripts/arkiv-dev-key.ts [--dev-flags]` fills it (and the two secrets above) from ARKIV_TEST_MNEMONIC index 3 if missing.
ARKIV_OPERATOR_PRIVATE_KEY=
# Dev only (ignored when NODE_ENV=production): WEBHOOK_SYNC=1 makes POST /webhooks/resend wait for the whole pipeline (Arkiv write
# included, several seconds) and answer {"status":"stored"}. Needed by the live scripts; the default answers 200 {"status":"accepted"}
# right after the event is recorded and finishes in the background.
WEBHOOK_SYNC=
# Dev only (ignored when NODE_ENV=production): DEV_ROUTES=1 mounts GET /internal/dev/inbox/:agentEns (metadata only).
DEV_ROUTES=
